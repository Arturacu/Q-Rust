# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/


.DS_Store

# Internal specifications (not tracked)
.specifications/

# Benchmark and temporary execution artifacts
.venv/
.venv-comparison/
benchmark/
qasm_dumps/
*.qasm
!tests/fixtures/*.qasm

# Benchmark harness: version-control code and fixtures only. Everything
# else under experiments/ (generated outputs, local documents) is untracked.
experiments/*
!experiments/Cargo.toml
!experiments/CORRECTNESS_REPAIR.md
!experiments/COMPARISON_STUDY.md
!experiments/ROUTING_INVESTIGATION.md
!experiments/BLOCK_SYNTHESIS_INVESTIGATION.md
!experiments/block_results_20261016.json
!experiments/block_cells_20261016.csv
!experiments/QFT_W_REFINEMENT.md
!experiments/qft_w_results_20261016.json
!experiments/qft_w_cells_20261016.csv
!experiments/routing_results_20261016.json
!experiments/routing_cells_20261016.csv
!experiments/validation/
!experiments/validation/*.json
!experiments/src/
!experiments/*.py
!experiments/requirements.txt
!experiments/requirements-comparison.txt
!experiments/external_sources.json
!experiments/external_sources/
!experiments/external_sources/**
!experiments/EXTERNAL_BENCHMARKS.md
!experiments/EXTERNAL_BENCHMARK_METHODS.md
!experiments/EXTERNAL_COMPILER_RECIPES.md
!experiments/EXTERNAL_COMPATIBILITY_FOLLOWUP.md
!experiments/EXTERNAL_ROUTING_FOLLOWUP.md
!experiments/external_results/
!experiments/external_results/**
!experiments/fixtures/
!experiments/fixtures/*.qasm
!experiments/fixtures/manifest.json

# Agent working state — never commit.
.claude/
